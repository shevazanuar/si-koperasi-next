model aset_tetap {
  id                 Int                 @id @default(autoincrement())
  nama_aset          String              @db.VarChar(150)
  kategori_id        Int
  tanggal_pembelian   DateTime            @db.Date
  tanggal_penghentian DateTime?           @db.Date
  nilai_pembelian     Decimal             @db.Decimal(15, 2)
  nilai_residu        Decimal             @default(0.00) @db.Decimal(15, 2)
  penyusutan_per_bulan Decimal            @default(0.00) @db.Decimal(15, 2)
  masa_manfaat        Int                 
