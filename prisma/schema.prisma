  user_email         String? @db.VarChar(255)

  @@ignore
}

model t_lelang {
  id               Int       @id @default(autoincrement())
  id_arisan        Int?
  bulan            DateTime? @db.Date
  iuran            BigInt?
  saldo_sebelumnya BigInt?
  jumlah           Int?
  lelang           Int?
  total            BigInt?
  jml_arisan       Int?
  saldo            BigInt?
  jml_pemenang     Int?
  peserta          String?   @db.VarChar(11)
}

model users {
  id          Int           @id @default(autoincrement())
  username    String?       @db.VarChar(50)
  password    String        @db.VarChar(255)
  namalengkap String?       @db.VarChar(100)
  level_id    Int
  foto        String        @db.VarChar(50)
  blokir      users_blokir?
}

model kategori_produk {
  id            Int             @id @default(autoincrement())
  nama_kategori String          @db.VarChar(100)
  created_at    DateTime        @default(now()) @db.Timestamp(0)
  updated_at    DateTime?       @updatedAt @db.Timestamp(0)
  barang        master_barang[]
}

model master_barang {
  id          Int                @id @default(autoincrement())
  kode_barang String             @unique(map: "kode_barang") @db.VarChar(50)
  nama_barang String             @db.VarChar(150)
  kategori_id Int
  deskripsi   String?            @db.Text
  gambar      String?            @db.VarChar(255)
  stok        Int                @default(0)
  harga_modal Decimal            @db.Decimal(15, 2)
  harga_jual  Decimal            @db.Decimal(15, 2)
  satuan      String?            @db.VarChar(30)
  status      String             @default("Aktif") @db.VarChar(20)
  is_featured Boolean            @default(false)
  created_at  DateTime           @default(now()) @db.Timestamp(0)
  updated_at  DateTime?          @updatedAt @db.Timestamp(0)
  detail      detail_penjualan[]
  kategori    kategori_produk    @relation(fields: [kategori_id], references: [id], onUpdate: Restrict, map: "fk_master_barang_kategori")

  @@index([kategori_id], map: "idx_master_barang_kategori")
}

model penjualan {
  id                Int                @id @default(autoincrement())
  kode_penjualan    String             @unique(map: "kode_penjualan") @db.VarChar(50)
  anggota_id        Int?
  nama_pembeli      String?            @db.VarChar(100)
  user_id           Int
  tanggal_penjualan DateTime           @default(now()) @db.DateTime(0)
  total_harga       Decimal            @default(0.00) @db.Decimal(15, 2)
  total_modal       Decimal            @default(0.00) @db.Decimal(15, 2)
  total_laba        Decimal            @default(0.00) @db.Decimal(15, 2)
  metode_pembayaran String?            @db.VarChar(50)
  status            String             @default("Selesai") @db.VarChar(20)
  created_at        DateTime           @default(now()) @db.Timestamp(0)
  updated_at        DateTime?          @updatedAt @db.Timestamp(0)
  detail            detail_penjualan[]
  anggota           anggota?           @relation(fields: [anggota_id], references: [id], onDelete: SetNull, onUpdate: Restrict)

  @@index([anggota_id], map: "idx_penjualan_anggota")
  @@index([tanggal_penjualan], map: "idx_penjualan_tanggal")
  @@index([user_id], map: "idx_penjualan_user")
}

model detail_penjualan {
  id             Int           @id @default(autoincrement())
  penjualan_id   Int
  barang_id      Int
  qty            Int
  harga_jual     Decimal       @db.Decimal(15, 2)
  harga_modal    Decimal       @db.Decimal(15, 2)
  subtotal_harga Decimal       @db.Decimal(15, 2)
  subtotal_modal Decimal       @db.Decimal(15, 2)
  subtotal_laba  Decimal       @db.Decimal(15, 2)
  created_at     DateTime      @default(now()) @db.Timestamp(0)
  barang         master_barang @relation(fields: [barang_id], references: [id], onUpdate: Restrict, map: "fk_detail_penjualan_barang")
  penjualan      penjualan     @relation(fields: [penjualan_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_detail_penjualan_penjualan")

  @@index([barang_id], map: "idx_detail_penjualan_barang")
  @@index([penjualan_id], map: "idx_detail_penjualan_penjualan")
}

model audit_log {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  username    String?   @db.VarChar(100)
  aksi        String    @db.VarChar(100)
  tabel       String?   @db.VarChar(100)
  record_id   Int?
  before_data String?   @db.LongText
  after_data  String?   @db.LongText
  ip_address  String?   @db.VarChar(45)
  keterangan  String?   @db.Text
  created_at  DateTime? @default(now()) @db.DateTime(0)

  @@index([aksi], map: "idx_aksi")
  @@index([created_at], map: "idx_created_at")
  @@index([user_id], map: "idx_user_id")
}

model pendapatan {
  id               Int      @id @default(autoincrement())
  jenis_pendapatan String   @db.VarChar(100)
  nominal          Decimal  @db.Decimal(15, 2)
  tanggal_laporan  DateTime @db.Date
  periode          String?  @db.VarChar(50)
  created_at       DateTime @default(now()) @db.Timestamp(0)
}

enum jenis_pinjaman_satuan {
  Minggu
  Bulan
  Tahun
}

enum users_blokir {
  Y
  T
}

enum menu_aktif {
  Y
  T
}

enum simpanan_jenis {
  S
  T
}

enum pengajuan_pinjaman_status {
  Open
  Cancel
  Acc
}

enum simpanan_entry {
  G
  I
}

enum anggota_status {
  Aktif
  Keluar
}

enum anggota_asli_status {
  Aktif
  Keluar
}

enum anggota_copy1_status {
  Aktif
  Keluar
}

